def get_total_price(request):
    pay_price = 0
    basket_pays = ShopBasket.objects.filter(user_id=request.user.id)
    for basket_pay in basket_pays:
        pay_price += basket_pay.total_price
    return pay_price


class OrdersInfoView(View, LoginRequiredMixin):
    template_name = 'orders/PayTemplate.html'

    def get(self, request):
        user = User.object.get(id=request.user.id)
        if not user.is_admin:
            pay_price = get_total_price(request)
            order = OrdersModel.objects.filter(user=request.user, total_price=pay_price, pay=False)
            if not order.exists():
                tracking_code = random.randint(10000, 99999)
                order = OrdersModel(user=request.user, total_price=pay_price, tracking_code=tracking_code)
                if pay_price > 0:
                    order.save()
                products = ShopBasket.objects.filter(user_id=user.id)
                for product in products:
                    shop_basket = ShopBasket.objects.filter(user_id=user.id, product=product.product)
                    for basket in shop_basket:
                        order_basket = OrdersInterface(order=order, product=product.product, count_pro=basket.count_pro,
                                                       total_price=basket.total_price)
                        order_basket.save()
                    # shop_basket.delete()
            return render(request, self.template_name, {'pay_price': pay_price, 'user': user, 'order': order})

    def post(self, request):
        user = User.object.get(id=request.user.id)
        if not user.is_admin:
            pay_price = get_total_price(request)
            return render(request, self.template_name, {'pay_price': pay_price, 'user': user})


